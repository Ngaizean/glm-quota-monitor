{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GLM Quota Monitor",
  "version": "5.1.0",
  "identifier": "com.ngaizean.glm-quota-monitor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src ipc://localhost https://github.com https://api.github.com https://objects.githubusercontent.com https://*.releases.download.githubusercontent.com https://chatgpt.com https://gist.githubusercontent.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' asset: https://asset.localhost"
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "../Info.plist",
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "languages": ["SimpChinese", "English"]
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/Ngaizean/glm-quota-monitor/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVFOThDRkQyRTdGNTJFODAKUldTQUx2WG4wcytZWGpUVVVMQ2kwVXI1WDJYMlMwSWVsZm5yeTNrWDlnWGtvU2Evdlg3M2FmOW0K",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
